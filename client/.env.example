# TripTrack PWA Client Environment Configuration Example
# Copy to .env.local for local overrides. None of these contain secret keys.

# Production Backend URL (e.g. Render Web Service)
VITE_BACKEND_URL=https://triptrack-api.onrender.com

# Shared Family PIN (Default: 2026)
VITE_FAMILY_PIN=2026

# Optional Traveller Name Overrides (Loaded into fallback offline config)
VITE_FAMILY_A_SON_NAME=Utkarsh
VITE_FAMILY_A_SON_AGE=30
VITE_FAMILY_A_SON_BLOOD=B+

VITE_FAMILY_A_ELDER_NAME=Rajnish
VITE_FAMILY_A_ELDER_AGE=65
VITE_FAMILY_A_ELDER_BLOOD=B+

VITE_FAMILY_B_SON_NAME=Shreyas
VITE_FAMILY_B_SON_AGE=28
VITE_FAMILY_B_SON_BLOOD=O+

VITE_FAMILY_B_ELDER_NAME=Sanjay
VITE_FAMILY_B_ELDER_AGE=62
VITE_FAMILY_B_ELDER_BLOOD=A+
